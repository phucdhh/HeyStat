# ── Database ────────────────────────────────────────────────────
# docker-compose.yml reads DB_NAME/DB_USER/DB_PASSWORD for the database
# container and these two URLs for the API, so both must agree. On the server
# this file is also symlinked as classroom/.env, which is where compose looks
# up ${DB_PASSWORD}:  ln -sf api/.env /root/HeyStat/classroom/.env
DB_NAME=classroom
DB_USER=heystat
DB_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://heystat:change-me@db:5432/classroom
SYNC_DATABASE_URL=postgresql+psycopg2://heystat:change-me@db:5432/classroom

# ── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ─────────────────────────────────────────────────────────
# Generate a strong secret: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-64-char-random-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── jamovi collab sessions ──────────────────────────────────────
# Same value must reach the jamovi container (start-heystat-linux.sh copies it
# from here) and the API, which signs the collab_role token with it.
JAMOVI_COLLAB_SECRET=change-me-to-a-64-char-random-hex-string

# ── File storage ─────────────────────────────────────────────────
UPLOAD_DIR=/uploads
JAMOVI_DATA_ROOT=/root/Documents
MAX_FILE_SIZE_MB=50
MAX_USER_FILES=100
MAX_USER_STORAGE_MB=500

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ── Celery ───────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Email (optional – for password reset) ───────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
